{
  "manifest_version": 3,
  "name": "BD Govt Job Autofill",
  "version": "6.1",
  "description": "Auto-fill Teletalk Govt job applications & auto-solve CAPTCHAs with built-in ONNX OCR.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "ocr.js",
        "crop.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "captcha_model.onnx",
        "charset.json",
        "onnxruntime.min.js",
        "*.wasm",
        "*.mjs"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "start-ocr": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Start Screen OCR / Solve CAPTCHA"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}